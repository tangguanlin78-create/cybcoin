# ============================================================
# 敏感配置示例  —— 复制为 .env 后填写真实值，.env 不要提交 Git
# ============================================================
# monitor.py 启动时通过 python-dotenv 自动加载同目录下的 .env
# 优先级：系统环境变量 > .env 文件 > config.json
# systemd 部署时改用 EnvironmentFile=/etc/systemd/system/erc20-monitor.env

# 只读 RPC 节点 URL（必须）。无需私钥，Alchemy / Infura / Ankr 任一
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# 飞书自定义机器人 webhook URL（必须）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK_TOKEN

# CoinGecko API key（可选，免费版留空）
COINGECKO_API_KEY=
